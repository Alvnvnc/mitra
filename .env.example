# Copy to .env and fill in. Never commit .env.
# Everything below is optional: without a Nebius key the app runs its
# deterministic local model and says so in the UI.

# --- Nebius Token Factory (live inference) ---
# Get a key: https://tokenfactory.nebius.com → API keys
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# --- Model routing (purpose -> model id) ---
# fast: high-volume extraction / classification
MITRA_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# chat: everyday chat + tool calling
MITRA_MODEL_CHAT=nvidia/nemotron-3-super-120b-a12b
# reasoning: hard planning, research synthesis
MITRA_MODEL_REASONING=nvidia/Nemotron-3-Ultra-550b-a55b

# --- Runtime ---
# auto = Nebius when a key is present, local demo model otherwise
# nebius = always Nebius (fail loudly) | demo = always the local model
MITRA_PROVIDER=auto
# Synthetic demo instance: banner, rate limits, reset button
MITRA_DEMO_MODE=0
# Shared secret for a public dashboard (access via ?token=...)
MITRA_DASHBOARD_TOKEN=
# Hard ceiling on inference spend per day, in USD
MITRA_DAILY_BUDGET_USD=0.50
MITRA_TIMEZONE=Asia/Jakarta
# MITRA_DATA_DIR=data

# --- Push notifications (default lane: ntfy.sh — no account needed) ---
# Pick a secret topic, subscribe to it in the ntfy app or at https://ntfy.sh/<topic>
NTFY_TOPIC=
# NTFY_BASE_URL=https://ntfy.sh

# --- Telegram bot (optional alternative lane) ---
# Create a bot with @BotFather and paste the token here
TELEGRAM_BOT_TOKEN=
# Telegram chat id for baseline/testing (run: python scripts/telegram_ping.py --whoami)
TELEGRAM_CHAT_ID=

# --- Tools ---
# Tavily: https://tavily.com (Best Use of Tavily bonus award)
TAVILY_API_KEY=

LOG_LEVEL=INFO
